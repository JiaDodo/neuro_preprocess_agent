{
  "runtime": {"mode": "run"},
  "preflight": {
    "enabled": true,
    "minimum_free_disk_gb": 100,
    "check_database": true,
    "check_docker": true,
    "check_resource_budget": true
  },
  "supervisor": {"mode": "rule"},
  "source": {
    "name": "OpenNeuro ds000001 ten-subject stability cohort",
    "type": "openneuro",
    "dataset_id": "ds000001",
    "uri": "https://openneuro.org",
    "include": [
      "dataset_description.json",
      "participants.tsv",
      "README",
      "CHANGES",
      "task-balloonanalogrisktask_bold.json",
      "sub-01",
      "sub-02",
      "sub-03",
      "sub-04",
      "sub-05",
      "sub-06",
      "sub-07",
      "sub-08",
      "sub-09",
      "sub-10"
    ],
    "max_concurrency": 4
  },
  "storage": {
    "raw_dir": "data/openneuro_sample",
    "processed_dir": "data/processed",
    "report_dir": "runs/reports",
    "copy_local_data": false
  },
  "preprocess": {
    "input_format": "bids",
    "bids_dir": "data/bids",
    "derivatives_dir": "data/derivatives/fmriprep_ds000001_stability",
    "log_dir": "runs/logs/fmriprep_ds000001_stability",
    "work_dir": "data/work/fmriprep_ds000001_stability",
    "lock_dir": "runs/locks/fmriprep_ds000001_stability",
    "dcm2bids": "dcm2bids",
    "dcm2bids_config": "configs/dcm2bids.example.json",
    "freesurfer_license": "data/private/license.txt",
    "fmriprep_image": "nipreps/fmriprep:latest",
    "run_fmriprep": true,
    "max_workers": 4,
    "subjects": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10"],
    "validate_bids": true,
    "reuse_completed": true,
    "fmriprep_options": {
      "output_layout": "bids",
      "output_spaces": ["MNI152NLin2009cAsym"],
      "nprocs": 16,
      "omp_nthreads": 8,
      "memory_mb": 32000,
      "low_mem": false,
      "anat_only": false,
      "level": "full",
      "ignore": [],
      "force": [],
      "subject_anatomical_reference": "first-lex",
      "skull_strip_t1w": "auto",
      "fs_no_reconall": true,
      "skip_bids_validation": false,
      "stop_on_first_crash": true
    }
  },
  "qc": {
    "engine": "rule_file_image_qc",
    "min_output_items": 1,
    "min_visual_artifacts": 3,
    "fd_threshold_mm": 0.5,
    "max_mean_fd_mm": 0.5,
    "max_fd_outlier_fraction": 0.2,
    "max_mean_std_dvars": 1.5,
    "block_database_on_review": true,
    "human_review_enabled": true,
    "require_review_note": true,
    "quantitative": {
      "enabled": true,
      "output_dir": "runs/qc",
      "max_nonfinite_fraction": 0,
      "min_mask_voxels": 1000,
      "max_mask_edge_fraction": 0.01,
      "min_bold_tsnr": 20,
      "min_anat_bold_mask_dice": 0.8
    },
    "visual": {"enabled": false}
  },
  "database": {
    "enabled": true,
    "backend": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "user": "neuro_agent",
    "password_env": "NEURO_AGENT_MYSQL_PASSWORD",
    "database": "neuro_preprocess",
    "connect_timeout": 10,
    "max_attempts": 3,
    "retry_interval_seconds": 2
  },
  "permissions": {
    "preflight": "allow",
    "source": "allow",
    "fetch": "ask",
    "preprocess": "ask",
    "qc": "allow",
    "db": "ask",
    "report": "allow"
  }
}
