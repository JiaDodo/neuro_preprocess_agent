{
  "runtime": {
    "mode": "run"
  },
  "supervisor": {
    "mode": "rule"
  },
  "source": {
    "name": "OpenNeuro ds000001 three-subject stability batch",
    "type": "openneuro",
    "dataset_id": "ds000001",
    "uri": "https://openneuro.org",
    "include": [
      "dataset_description.json",
      "participants.tsv",
      "README",
      "CHANGES",
      "task-balloonanalogrisktask_bold.json",
      "sub-01",
      "sub-02",
      "sub-03"
    ],
    "max_concurrency": 4
  },
  "storage": {
    "raw_dir": "data/openneuro_sample",
    "processed_dir": "data/processed",
    "report_dir": "runs/reports",
    "copy_local_data": false
  },
  "preprocess": {
    "input_format": "bids",
    "bids_dir": "data/bids",
    "derivatives_dir": "data/derivatives/fmriprep_ds000001_stability",
    "log_dir": "runs/logs/fmriprep_ds000001_stability",
    "work_dir": "data/work/fmriprep_ds000001_stability",
    "lock_dir": "runs/locks/fmriprep_ds000001_stability",
    "dcm2bids": "dcm2bids",
    "dcm2bids_config": "configs/dcm2bids.example.json",
    "freesurfer_license": "data/private/license.txt",
    "fmriprep_image": "nipreps/fmriprep:latest",
    "run_fmriprep": true,
    "max_workers": 2,
    "validate_bids": true,
    "reuse_completed": true,
    "fmriprep_options": {
      "output_layout": "bids",
      "output_spaces": [
        "MNI152NLin2009cAsym"
      ],
      "nprocs": 16,
      "omp_nthreads": 8,
      "memory_mb": 32000,
      "low_mem": false,
      "anat_only": false,
      "level": "full",
      "ignore": [],
      "force": [],
      "subject_anatomical_reference": "first-lex",
      "skull_strip_t1w": "auto",
      "fs_no_reconall": true,
      "skip_bids_validation": false,
      "stop_on_first_crash": true
    }
  },
  "qc": {
    "engine": "rule_file_image_qc",
    "min_output_items": 1,
    "min_visual_artifacts": 3,
    "fd_threshold_mm": 0.5,
    "max_mean_fd_mm": 0.5,
    "max_fd_outlier_fraction": 0.2,
    "max_mean_std_dvars": 1.5,
    "block_database_on_review": true,
    "human_review_enabled": true,
    "require_review_note": true,
    "visual": {
      "enabled": true,
      "mode": "shadow",
      "packet_dir": "data/visual_qc/packets",
      "labels_path": "data/visual_qc/labels.jsonl",
      "model_backend": "dinov2_embedding",
      "model_id": "data/models/facebook_dinov2-small",
      "device": "cuda:0",
      "allow_model_download": false,
      "reference_path": null,
      "anomaly_threshold": null
    }
  },
  "database": {
    "enabled": true,
    "backend": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "user": "neuro_agent",
    "password_env": "NEURO_AGENT_MYSQL_PASSWORD",
    "database": "neuro_preprocess"
  },
  "permissions": {
    "source": "allow",
    "fetch": "ask",
    "preprocess": "ask",
    "qc": "allow",
    "db": "ask",
    "report": "allow"
  }
}
