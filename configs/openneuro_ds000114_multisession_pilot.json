{
  "runtime": {"mode": "run"},
  "preflight": {"enabled": true, "minimum_free_disk_gb": 100, "check_database": true, "check_docker": true, "check_resource_budget": true},
  "supervisor": {"mode": "rule"},
  "source": {
    "name": "OpenNeuro ds000114 multi-session pilot",
    "type": "openneuro",
    "dataset_id": "ds000114",
    "uri": "https://openneuro.org",
    "tag": "1.0.2",
    "include": [
      "dataset_description.json", "participants.tsv", "CHANGES", "dwi.bval", "dwi.bvec",
      "task-covertverbgeneration_bold.json", "task-fingerfootlips_bold.json",
      "task-linebisection_bold.json", "task-overtverbgeneration_bold.json",
      "task-overtwordrepetition_bold.json", "sub-01"
    ],
    "max_concurrency": 4
  },
  "storage": {"raw_dir": "data/openneuro_cross_dataset", "processed_dir": "data/processed", "report_dir": "runs/reports", "copy_local_data": false},
  "preprocess": {
    "input_format": "bids", "bids_dir": "data/bids",
    "derivatives_dir": "data/derivatives/fmriprep_ds000114_pilot",
    "log_dir": "runs/logs/fmriprep_ds000114_pilot",
    "work_dir": "data/work/fmriprep_ds000114_pilot",
    "lock_dir": "runs/locks/fmriprep_ds000114_pilot",
    "dcm2bids": "dcm2bids", "dcm2bids_config": "configs/dcm2bids.example.json",
    "freesurfer_license": "data/private/license.txt", "fmriprep_image": "nipreps/fmriprep:latest",
    "run_fmriprep": true, "max_workers": 1, "subjects": ["01"], "validate_bids": true, "reuse_completed": true,
    "fmriprep_options": {
      "output_layout": "bids", "output_spaces": ["MNI152NLin2009cAsym"],
      "nprocs": 16, "omp_nthreads": 8, "memory_mb": 32000,
      "subject_anatomical_reference": "unbiased", "skull_strip_t1w": "auto",
      "fs_no_reconall": true, "stop_on_first_crash": true
    },
    "fmriprep_args": ["--task-id", "linebisection"]
  },
  "qc": {"engine": "rule_file_image_qc", "min_output_items": 1, "min_visual_artifacts": 3, "block_database_on_review": true, "human_review_enabled": true, "require_review_note": true, "quantitative": {"enabled": true, "output_dir": "runs/qc", "min_bold_tsnr": 20, "min_anat_bold_mask_dice": 0.8}, "visual": {"enabled": false}},
  "database": {"enabled": true, "backend": "mysql", "host": "127.0.0.1", "port": 3306, "user": "neuro_agent", "password_env": "NEURO_AGENT_MYSQL_PASSWORD", "database": "neuro_preprocess", "connect_timeout": 10, "max_attempts": 3, "retry_interval_seconds": 2},
  "permissions": {"preflight": "allow", "source": "allow", "fetch": "ask", "preprocess": "ask", "qc": "allow", "db": "ask", "report": "allow"}
}
